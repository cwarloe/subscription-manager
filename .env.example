# Server-only. Never commit real values.
# The hosted preview injects these itself. Set them only for your own deployment.

# Postgres connection string. When unset, local preview uses embedded Postgres.
DATABASE_URL=

# Better Auth secret for a self-hosted deploy. Injected for you on the hosted app.
BETTER_AUTH_SECRET=

# Enables live official-page extraction. Refresh still works as a recorded failure without it.
# Each refresh of one page is one chat completion on your xAI account (model grok-4.5).
XAI_API_KEY=

# Present on the hosted app. Do not put this in the browser.
GROK_PROJECT_ID=
